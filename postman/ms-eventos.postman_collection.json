            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Palco\",\n  \"precio\": 90000,\n  \"aforo\": 20\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Reservar 3 entradas - descuenta aforo (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/eventos/{{eventoId}}/tipos-entrada/{{tipoId}}/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "eventos",
            "{{eventoId}}",
            "tipos-entrada",
            "{{tipoId}}",
            "reservas"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenStaff}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cantidad\": 3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('aforoDisponible = 497', () => pm.expect(pm.response.json().aforoDisponible).to.eql(497));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Reservar mas del aforo disponible (409)",
