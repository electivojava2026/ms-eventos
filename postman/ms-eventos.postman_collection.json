              "key": "token",
              "value": "{{tokenStaff}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Concierto Rock (actualizado)\",\n  \"descripcion\": \"Cambio de recinto\",\n  \"lugar\": \"Movistar Arena\",\n  \"fechaEvento\": \"2026-12-20T21:00:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Agregar tipo de entrada como STAFF (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
